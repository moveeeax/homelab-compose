# ── Domain & TLS ──────────────────────────────────────────────
# Base domain. Services are published as <service>.${DOMAIN}
# (grafana.example.com, traefik.example.com, ...).
DOMAIN=example.com
# Email used for the Let's Encrypt ACME account.
ACME_EMAIL=you@example.com
# Basic-auth for the Traefik dashboard, as user:bcrypt-hash.
# Generate (note the doubled $$ so compose does not interpolate it):
#   htpasswd -nbB admin 'yourpassword' | sed -e 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$YtE3jZ0mS1n0Q2m3O0mQ5uJt9m6Xk6Qm2wq3wq4wq5wq6wq7wq8W

# ── General ───────────────────────────────────────────────────
TZ=Europe/Moscow

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ── Prometheus ────────────────────────────────────────────────
PROMETHEUS_RETENTION=15d

# ── Backups (restic) ──────────────────────────────────────────
# restic repository. Local path, or s3:s3.amazonaws.com/bucket/prefix, etc.
RESTIC_REPOSITORY=/srv/backups/restic
# Encryption password for the restic repository (keep it safe!).
RESTIC_PASSWORD=changeme-restic
# Host directory to back up, mounted read-only into the backup container.
BACKUP_SOURCE=/srv/homelab/data
# When to run the backup (standard crontab format).
BACKUP_CRON=0 3 * * *
# Retention policy applied by `restic forget --prune`.
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
# The BackupStale alert fires when the last successful backup is older than
# this many seconds. 93600 = 26h, for a daily BACKUP_CRON; lower it if you
# back up more often.
BACKUP_STALE_AFTER_SECONDS=93600
# Optional ping after every run. Success POSTs to BACKUP_NOTIFY_URL; failure
# POSTs to BACKUP_NOTIFY_FAIL_URL, or to ${BACKUP_NOTIFY_URL}/fail when that is
# empty (healthchecks.io style). For ntfy, set both to the same topic URL.
BACKUP_NOTIFY_URL=
BACKUP_NOTIFY_FAIL_URL=
# Only needed when RESTIC_REPOSITORY is an S3/MinIO backend.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
